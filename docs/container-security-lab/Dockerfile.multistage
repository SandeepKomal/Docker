# Build stage: install production dependencies and gather only what runs.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY app.js ./

# Runtime stage: the same base, an unprivileged user, and only the app.
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
RUN groupadd --system app && useradd --system --gid app --create-home app
COPY --from=build --chown=app:app /app ./
USER app
EXPOSE 3000
CMD ["node","app.js"]
